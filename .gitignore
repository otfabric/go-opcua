# Ignore python directories
dist/
__pycache__/

# Ignore the bin directory
/bin/
*.exe
*.log

# Ignore IDE settings
.vscode/
.idea/

# Ignore coverage files (keep interop coverage ledger tracked)
cover.*
/coverage.*
*.out
!interop/coverage.json
!interop/COVERAGE.md

# Certificates
*.pem
*.crt
*.csr
# OpenSSL-generated known-answer fixtures (test-only keys)
!uapolicy/testdata/openssl/*.pem
!uapolicy/testdata/pkix/*.pem
# Claude Code agent worktrees
.claude/
coverage-gate.out

# Compiled test binaries (go test -c)
*.test
/method_server

# Build artefacts live in /bin/ and /release/ (otfabric/engineering REPO-005)
/release/
coverage.out

# Output of a bare `go build`, anchored so it can never hide a source folder
/cmd/attrid/attrid
/cmd/capability/capability
/cmd/id/id
/cmd/permissions/permissions
/cmd/service/service
/cmd/status/status
/examples/accesslevel/accesslevel
